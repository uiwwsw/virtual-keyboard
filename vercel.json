{
  "buildCommand": "npm run build",
  "outputDirectory": "demo-dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "composed-input.vercel.app"
        }
      ],
      "destination": "https://virtual-keyboard-uiwwsw.vercel.app/:path*",
      "statusCode": 301
    }
  ]
}
